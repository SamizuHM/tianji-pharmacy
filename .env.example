# =========================
# Database
# =========================
# POSTGRES_* 用于 docker compose 初始化 PostgreSQL 容器。
# DATABASE_URL 用于本地 pnpm dev / Prisma CLI 连接数据库。
# Docker 内的 web 服务会在 docker-compose.yml 中根据 POSTGRES_* 自动生成容器内 DATABASE_URL。
POSTGRES_DB="tianji_pharmacy"
POSTGRES_USER="tianji"
POSTGRES_PASSWORD="change_me_strong_password"
DATABASE_URL="postgresql://tianji:change_me_strong_password@127.0.0.1:5432/tianji_pharmacy?schema=public"

# =========================
# LLM / DashScope
# =========================
# OPENAI_* 走 OpenAI-compatible 接口，用于最终回答、图片理解和部分摘要任务。
# Embedding / rerank 由 ML Service 使用 DashScope SDK 调用，同样复用 OPENAI_API_KEY。
OPENAI_BASE_URL="https://your-openai-compatible-endpoint/v1"
OPENAI_API_KEY="your_api_key"
OPENAI_MODEL="qwen3.5-27b"

# =========================
# Retrieval
# =========================
RETRIEVAL_TOP_K="8"
RERANK_TOP_N="5"
KB_HIT_THRESHOLD="0.72"
MAX_CONTEXT_TURNS="6"

# =========================
# Local paths and service URLs
# =========================
# 这些 URL 给本地 pnpm dev 使用。
# Docker 编排时，web 服务会由 docker-compose.yml 注入 qdrant / ml-service 容器内地址。
UPLOAD_DIR="./uploads"
SERVICE_HOTLINE="027-xxxx"
AUTO_IMPORT_KNOWLEDGE_ON_FIRST_BOOT="true"
QDRANT_URL="http://127.0.0.1:6333"
EMBEDDING_SERVICE_URL="http://127.0.0.1:8001/embed"
RERANK_SERVICE_URL="http://127.0.0.1:8001/rerank"
ML_SERVICE_URL="http://127.0.0.1:8001"
SESSION_TTL_HOURS="72"

# =========================
# Deployment
# =========================
# 仅 docker compose + cloudflared 部署时需要。
CF_TUNNEL_TOKEN="your_cloudflared_tunnel_token"
