generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  staff
  department
  admin
}

enum MessageRole {
  user
  assistant
  agent
  system
}

enum MessageSourceType {
  kb
  llm
  manual
  system
}

enum TicketStatus {
  pending_claim
  processing
  escalated
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
}

enum TicketMessageType {
  text
  image
  system
}

enum TicketKnowledgeStatus {
  not_ready
  pending_writeback
  written
}

enum MessageFeedback {
  helpful
  unhelpful
}

enum MessageStatus {
  streaming
  completed
  failed
}

enum KnowledgeSourceType {
  seed_doc
  image_doc
  manual_ticket
  manual
  uploaded_doc
  manual_qa
}

enum KnowledgeStatus {
  draft
  published
  archived
}

enum KnowledgeDocumentStatus {
  draft
  published
  archived
}

enum KnowledgeParserType {
  basic_text
  pdf_text
  docx_layout
  image_vlm
  legacy_qa
}

enum KnowledgeParseRunStatus {
  pending
  running
  success
  failed
}

enum KnowledgeChunkStrategy {
  fixed_overlap
  recursive
  heading
  qa
  page
  parent_child
}

enum KnowledgeScopeLevel {
  common
  city
}

enum ImportJobStatus {
  pending
  running
  success
  failed
}

enum KnowledgeIndexTaskType {
  upsert
  delete
}

enum KnowledgeIndexTaskStatus {
  pending
  processing
  completed
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  users       User[]
}

model Store {
  id           String   @id @default(cuid())
  name         String
  provinceCode String?
  provinceName String?
  cityName     String?
  districtCode String?
  districtName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]

  @@index([cityName])
}

model User {
  id                        String                     @id @default(cuid())
  username                  String                     @unique
  displayName               String
  passwordHash              String
  role                      UserRole
  enabled                   Boolean                    @default(true)
  sidebarTheme              String                     @default("blue")
  colorMode                 String                     @default("system")
  departmentId              String?
  storeId                   String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  department                Department?                @relation(fields: [departmentId], references: [id])
  store                     Store?                     @relation(fields: [storeId], references: [id])
  sessions                  Session[]
  conversations             Conversation[]
  createdTickets            Ticket[]                   @relation("TicketCreatedBy")
  closedTickets             Ticket[]                   @relation("TicketClosedBy")
  claimedTickets            Ticket[]                   @relation("TicketClaimedBy")
  escalatedTickets          Ticket[]                   @relation("TicketEscalatedTo")
  submittedResolutions      Ticket[]                   @relation("TicketResolutionSubmittedBy")
  ticketMessages            TicketMessage[]
  generatedKnowledgeDrafts  TicketKnowledgeDraft[]
  uploadedKnowledgeVersions KnowledgeDocumentVersion[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String        @id @default(cuid())
  title     String
  userId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  tickets   Ticket[]

  @@index([userId, deletedAt, updatedAt])
}

model ChatMessage {
  id                 String            @id @default(cuid())
  conversationId     String
  role               MessageRole
  sourceType         MessageSourceType
  contentText        String
  status             MessageStatus     @default(completed)
  attachmentsJson    String?
  retrievalDebugJson String?
  feedback           MessageFeedback?
  createdAt          DateTime          @default(now())
  conversation       Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([feedback])
}

model Ticket {
  id                          String                 @id @default(cuid())
  ticketNo                    String                 @unique
  status                      TicketStatus
  priority                    TicketPriority         @default(medium)
  createdByUserId             String
  conversationId              String?
  title                       String
  category                    String                 @default("门店问答")
  tagsJson                    String?
  latestUserQuestion          String
  inputMode                   String
  aiAnswerSnapshot            String
  conversationSnapshot        String
  resolutionText              String?
  firstRespondedAt            DateTime?
  escalatedAt                 DateTime?
  escalatedToDept             String?
  escalatedToUserId           String?
  satisfactionScore           Int?
  knowledgeStatus             TicketKnowledgeStatus  @default(not_ready)
  claimedByUserId             String?
  resolutionSubmittedAt       DateTime?
  resolutionSubmittedByUserId String?
  closedByUserId              String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  closedAt                    DateTime?
  createdBy                   User                   @relation("TicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  closedBy                    User?                  @relation("TicketClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  claimedBy                   User?                  @relation("TicketClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  escalatedToUser             User?                  @relation("TicketEscalatedTo", fields: [escalatedToUserId], references: [id], onDelete: SetNull)
  resolutionSubmittedBy       User?                  @relation("TicketResolutionSubmittedBy", fields: [resolutionSubmittedByUserId], references: [id], onDelete: SetNull)
  conversation                Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages                    TicketMessage[]
  knowledgeDrafts             TicketKnowledgeDraft[]

  @@index([status, createdAt])
  @@index([claimedByUserId])
  @@index([priority, createdAt])
  @@index([category])
  @@index([knowledgeStatus])
}

model TicketMessage {
  id           String            @id @default(cuid())
  ticketId     String
  senderRole   MessageRole
  senderUserId String?
  messageType  TicketMessageType
  content      String
  attachments  String?
  createdAt    DateTime          @default(now())
  ticket       Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser   User?             @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model TicketKnowledgeDraft {
  id                     String    @id @default(cuid())
  ticketId               String
  selectedMaterialsJson  String
  categoryL1             String
  categoryL2             String
  question               String
  answer                 String
  tagsJson               String?
  imagePathsJson         String?
  generatedByUserId      String
  confirmedAt            DateTime?
  writtenKnowledgeItemId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  ticket                 Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  generatedBy            User      @relation(fields: [generatedByUserId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([writtenKnowledgeItemId])
}

model KnowledgeItem {
  id             String              @id @default(cuid())
  categoryL1     String
  categoryL2     String
  question       String
  answer         String
  tagsJson       String?
  status         KnowledgeStatus     @default(published)
  sourceType     KnowledgeSourceType
  sourceTicketId String?
  sourceFile     String?
  docType        String?
  imagePath      String?
  imagePathsJson String?
  documentId     String?
  hitCount       Int                 @default(0)
  lastHitAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  chunks         KnowledgeChunk[]
  document       KnowledgeDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([categoryL1, categoryL2])
  @@index([sourceType, createdAt])
  @@index([status, updatedAt])
  @@index([hitCount])
  @@index([documentId])
}

model KnowledgeChunk {
  id                        String              @id @default(cuid())
  knowledgeItemId           String
  documentId                String?
  chunkSetId                String?
  parentChunkId             String?
  chunkIndex                Int
  chunkText                 String
  originalText              String
  sourceFile                String?
  docType                   String?
  qdrantPointId             String              @unique
  metadataJson              String
  scopeLevel                KnowledgeScopeLevel @default(common)
  cityName                  String?
  overrideScope             Boolean             @default(false)
  bm25SearchText            String?
  hypotheticalQuestionsJson String?
  sectionPath               String?
  pageStart                 Int?
  pageEnd                   Int?
  tokenCount                Int?
  enabled                   Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  knowledgeItem             KnowledgeItem       @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  document                  KnowledgeDocument?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkSet                  KnowledgeChunkSet?  @relation(fields: [chunkSetId], references: [id], onDelete: Cascade)
  parentChunk               KnowledgeChunk?     @relation("KnowledgeChunkParent", fields: [parentChunkId], references: [id], onDelete: SetNull)
  childChunks               KnowledgeChunk[]    @relation("KnowledgeChunkParent")

  @@index([knowledgeItemId, chunkIndex])
  @@index([documentId, chunkIndex])
  @@index([chunkSetId, chunkIndex])
  @@index([enabled])
  @@index([scopeLevel, cityName])
  @@index([overrideScope])
}

model KnowledgeDocument {
  id               String                     @id @default(cuid())
  title            String
  sourceType       KnowledgeSourceType
  sourceFile       String?
  mimeType         String?
  businessCategory String                     @default("通用")
  scopeLevel       KnowledgeScopeLevel        @default(common)
  cityName         String?
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  status           KnowledgeDocumentStatus    @default(draft)
  hitCount         Int                        @default(0)
  lastHitAt        DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  versions         KnowledgeDocumentVersion[]
  parseRuns        KnowledgeParseRun[]
  chunkSets        KnowledgeChunkSet[]
  chunks           KnowledgeChunk[]
  knowledgeItems   KnowledgeItem[]

  @@index([status, updatedAt])
  @@index([businessCategory, status])
  @@index([scopeLevel, cityName])
}

model KnowledgeDocumentVersion {
  id               String              @id @default(cuid())
  documentId       String
  originalFilePath String?
  sourceFileName   String?
  contentHash      String
  uploadedByUserId String?
  createdAt        DateTime            @default(now())
  document         KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy       User?               @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  parseRuns        KnowledgeParseRun[]

  @@index([documentId, createdAt])
  @@index([contentHash])
}

model KnowledgeParseRun {
  id                String                   @id @default(cuid())
  documentId        String
  documentVersionId String
  parserType        KnowledgeParserType
  status            KnowledgeParseRunStatus  @default(pending)
  extractedText     String?
  structuredJson    String?
  error             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  document          KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion   KnowledgeDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  chunkSets         KnowledgeChunkSet[]

  @@index([documentId, createdAt])
  @@index([status, createdAt])
}

model KnowledgeChunkSet {
  id            String                 @id @default(cuid())
  documentId    String
  parseRunId    String
  chunkStrategy KnowledgeChunkStrategy
  configJson    String?
  isActive      Boolean                @default(false)
  createdAt     DateTime               @default(now())
  document      KnowledgeDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parseRun      KnowledgeParseRun      @relation(fields: [parseRunId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([documentId, isActive])
  @@index([parseRunId])
}

model KnowledgeIndexTask {
  id              String                   @id @default(cuid())
  taskType        KnowledgeIndexTaskType
  status          KnowledgeIndexTaskStatus @default(pending)
  knowledgeItemId String?
  chunkId         String?
  pointId         String
  payloadJson     String?
  retryCount      Int                      @default(0)
  lastError       String?
  availableAt     DateTime                 @default(now())
  processedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([chunkId])
  @@index([knowledgeItemId])
  @@index([pointId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportJob {
  id        String          @id @default(cuid())
  source    String
  status    ImportJobStatus
  summary   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}
