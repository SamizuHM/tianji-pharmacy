generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  staff
  human_l1
  human_l2
}

enum MessageRole {
  user
  assistant
  human_l1
  human_l2
  system
}

enum MessageSourceType {
  kb
  llm
  manual
  system
}

enum TicketStatus {
  pending_l1
  pending_l2
  closed
}

enum TicketMessageType {
  text
  image
  system
}

enum KnowledgeSourceType {
  seed_doc
  image_doc
  manual_ticket
  manual
}

enum ImportJobStatus {
  pending
  running
  success
  failed
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  displayName   String
  passwordHash  String
  role          UserRole
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  conversations Conversation[]
  createdTickets Ticket[]      @relation("TicketCreatedBy")
  closedTickets Ticket[]       @relation("TicketClosedBy")
  ticketMessages TicketMessage[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id         String        @id @default(cuid())
  title      String
  userId     String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]
  tickets    Ticket[]
}

model ChatMessage {
  id                 String            @id @default(cuid())
  conversationId     String
  role               MessageRole
  sourceType         MessageSourceType
  contentText        String
  attachmentsJson    String?
  retrievalDebugJson String?
  createdAt          DateTime          @default(now())
  conversation       Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Ticket {
  id                   String         @id @default(cuid())
  ticketNo             String         @unique
  status               TicketStatus
  currentAssigneeRole  UserRole
  createdByUserId      String
  conversationId       String?
  title                String
  latestUserQuestion   String
  inputMode            String
  aiAnswerSnapshot     String
  conversationSnapshot String
  resolutionText       String?
  closedByUserId       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  closedAt             DateTime?
  createdBy            User           @relation("TicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  closedBy             User?          @relation("TicketClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  conversation         Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages             TicketMessage[]

  @@index([status, currentAssigneeRole, createdAt])
}

model TicketMessage {
  id           String            @id @default(cuid())
  ticketId      String
  senderRole    MessageRole
  senderUserId  String?
  messageType   TicketMessageType
  content       String
  attachments   String?
  createdAt     DateTime          @default(now())
  ticket        Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser    User?             @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model KnowledgeItem {
  id             String               @id @default(cuid())
  categoryL1     String
  categoryL2     String
  question       String
  answer         String
  tagsJson       String?
  sourceType     KnowledgeSourceType
  sourceTicketId String?
  sourceFile     String?
  docType        String?
  imagePath      String?
  imagePathsJson String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  chunks         KnowledgeChunk[]

  @@index([categoryL1, categoryL2])
  @@index([sourceType, createdAt])
}

model KnowledgeChunk {
  id           String   @id @default(cuid())
  knowledgeItemId String
  chunkIndex   Int
  chunkText    String
  originalText String
  sourceFile   String?
  docType      String?
  qdrantPointId String  @unique
  metadataJson String
  createdAt    DateTime @default(now())
  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId, chunkIndex])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportJob {
  id         String          @id @default(cuid())
  source     String
  status     ImportJobStatus
  summary    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

