generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  staff
  human_l1
  human_l2
}

enum MessageRole {
  user
  assistant
  human_l1
  human_l2
  system
}

enum MessageSourceType {
  kb
  llm
  manual
  system
}

enum TicketStatus {
  pending_claim
  processing
  escalated
  closed
}

enum TicketPriority {
  low
  medium
  high
}

enum TicketMessageType {
  text
  image
  system
}

enum MessageFeedback {
  helpful
  unhelpful
}

enum KnowledgeSourceType {
  seed_doc
  image_doc
  manual_ticket
  manual
}

enum KnowledgeStatus {
  draft
  published
  archived
}

enum ImportJobStatus {
  pending
  running
  success
  failed
}

enum KnowledgeIndexTaskType {
  upsert
  delete
}

enum KnowledgeIndexTaskStatus {
  pending
  processing
  completed
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  displayName   String
  passwordHash  String
  role          UserRole
  departmentId  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  department    Department?    @relation(fields: [departmentId], references: [id])
  sessions      Session[]
  conversations Conversation[]
  createdTickets Ticket[]      @relation("TicketCreatedBy")
  closedTickets Ticket[]       @relation("TicketClosedBy")
  claimedTickets Ticket[]      @relation("TicketClaimedBy")
  escalatedTickets Ticket[]    @relation("TicketEscalatedTo")
  submittedResolutions Ticket[] @relation("TicketResolutionSubmittedBy")
  ticketMessages TicketMessage[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id         String        @id @default(cuid())
  title      String
  userId     String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]
  tickets    Ticket[]

  @@index([userId, deletedAt, updatedAt])
}

model ChatMessage {
  id                 String            @id @default(cuid())
  conversationId     String
  role               MessageRole
  sourceType         MessageSourceType
  contentText        String
  attachmentsJson    String?
  retrievalDebugJson String?
  feedback           MessageFeedback?
  createdAt          DateTime          @default(now())
  conversation       Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([feedback])
}

model Ticket {
  id                          String         @id @default(cuid())
  ticketNo                    String         @unique
  status                      TicketStatus
  priority                    TicketPriority @default(medium)
  createdByUserId             String
  conversationId              String?
  title                       String
  category                    String         @default("门店问答")
  tagsJson                    String?
  latestUserQuestion          String
  inputMode                   String
  aiAnswerSnapshot            String
  conversationSnapshot        String
  resolutionText              String?
  firstRespondedAt            DateTime?
  escalatedAt                 DateTime?
  escalatedToDept             String?
  escalatedToUserId           String?
  satisfactionScore           Int?
  claimedByUserId             String?
  resolutionSubmittedAt       DateTime?
  resolutionSubmittedByUserId String?
  closedByUserId              String?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  closedAt                    DateTime?
  createdBy                   User           @relation("TicketCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  closedBy                    User?          @relation("TicketClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  claimedBy                   User?          @relation("TicketClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  escalatedToUser             User?          @relation("TicketEscalatedTo", fields: [escalatedToUserId], references: [id], onDelete: SetNull)
  resolutionSubmittedBy       User?          @relation("TicketResolutionSubmittedBy", fields: [resolutionSubmittedByUserId], references: [id], onDelete: SetNull)
  conversation                Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messages                    TicketMessage[]

  @@index([status, createdAt])
  @@index([claimedByUserId])
  @@index([priority, createdAt])
  @@index([category])
}

model TicketMessage {
  id           String            @id @default(cuid())
  ticketId      String
  senderRole    MessageRole
  senderUserId  String?
  messageType   TicketMessageType
  content       String
  attachments   String?
  createdAt     DateTime          @default(now())
  ticket        Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser    User?             @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model KnowledgeItem {
  id             String               @id @default(cuid())
  categoryL1     String
  categoryL2     String
  question       String
  answer         String
  tagsJson       String?
  status         KnowledgeStatus      @default(published)
  sourceType     KnowledgeSourceType
  sourceTicketId String?
  sourceFile     String?
  docType        String?
  imagePath      String?
  imagePathsJson String?
  hitCount       Int                  @default(0)
  lastHitAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  chunks         KnowledgeChunk[]

  @@index([categoryL1, categoryL2])
  @@index([sourceType, createdAt])
  @@index([status, updatedAt])
  @@index([hitCount])
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  knowledgeItemId String
  chunkIndex     Int
  chunkText      String
  originalText   String
  sourceFile     String?
  docType        String?
  qdrantPointId String  @unique
  metadataJson   String
  createdAt      DateTime @default(now())
  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([knowledgeItemId, chunkIndex])
}

model KnowledgeIndexTask {
  id          String                   @id @default(cuid())
  taskType    KnowledgeIndexTaskType
  status      KnowledgeIndexTaskStatus @default(pending)
  knowledgeItemId String?
  chunkId      String?
  pointId      String
  payloadJson  String?
  retryCount   Int                     @default(0)
  lastError    String?
  availableAt  DateTime                @default(now())
  processedAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([chunkId])
  @@index([knowledgeItemId])
  @@index([pointId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportJob {
  id         String          @id @default(cuid())
  source     String
  status     ImportJobStatus
  summary    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}
